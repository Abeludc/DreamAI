PORT=5000
NODE_ENV=development

# Configuración de Supabase (reemplazar con valores reales en producción)
SUPABASE_URL=https://your-supabase-url.supabase.co
SUPABASE_KEY=your-supabase-key

# Configuración de JWT
JWT_SECRET=dreamai_development_secret_key
JWT_EXPIRES_IN=7d

# Configuración de API de IA (reemplazar con valores reales)
AI_API_KEY=your-ai-api-key
AI_API_URL=https://api.openai.com/v1

# Configuración de Stripe (reemplazar con valores reales en producción)
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
